# Copy to .env for local dev. On EC2, set these as real environment
# variables (systemd EnvironmentFile) or, better, pull secrets from
# AWS Secrets Manager / SSM Parameter Store at deploy time — never
# commit a real .env file.

NODE_ENV=production
PORT=3000

# CORS: restrict to your real domain in production.
ALLOWED_ORIGIN=https://clinic.example.com

# Optional SQLite path. The default is data/qsmart.sqlite.
QSMART_DB_PATH=data/qsmart.sqlite
